APP_ENV=local
LOG_LEVEL=INFO
LOG_JSON=false
DATABASE_URL=sqlite+aiosqlite:///./data/streamrank.db
# DATABASE_URL=postgresql://user:pass@host/streamrank
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379/0

REQUIRE_API_KEY=false
API_KEYS=demo-key-streamrank
CORS_ORIGINS=*

ARTIFACTS_DIR=ml/artifacts
CATALOG_PATH=data/catalog.json

# retrieval
CANDIDATES_ANN=120
CANDIDATES_COVISIT=60
CANDIDATES_TRENDING=40
ANN_PROBE_CLUSTERS=6
MMR_LAMBDA=0.82
CATEGORY_CAP=6

# streaming features
SESSION_DECAY=0.86
TRENDING_HALFLIFE_S=900
SESSION_TTL_S=3600
FEATURE_FLUSH_INTERVAL_S=2.0

# experiment
EXPERIMENT_NAME=ranker-v1-vs-popularity
CONTROL_SHARE=0.5
CONTROL_VARIANT=popularity
TREATMENT_VARIANT=two-stage
